{
  "name": "banki-shop",
  "version": "1.0.0",
  "description": "Banki.shop — каталог картин эпохи Возрождения (Vue 2 Options API)",
  "private": true,
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "dev": "webpack serve --mode development --config webpack.config.js",
    "build": "webpack --mode production --config webpack.config.js",
    "build:gh": "cross-env PUBLIC_PATH=/banki-shop/ webpack --mode production --config webpack.config.js",
    "deploy": "npm run build:gh && npx --yes gh-pages@6.1.1 -d dist",
    "start": "webpack serve --mode development --config webpack.config.js"
  },
  "dependencies": {
    "vue": "^2.7.16"
  },
  "devDependencies": {
    "@types/node": "^16.18.96",
    "copy-webpack-plugin": "^11.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "html-webpack-plugin": "^5.6.0",
    "sass": "^1.77.8",
    "sass-loader": "^13.3.3",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^4.9.5",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  }
}
